  <string name="proposition.heading">Zo gebruikt de app jouw gegevens</string>
  <string name="proposition.statement_1"><![CDATA[Je gegevens worden <b>beveiligd</b> en via een <b>veilige verbinding</b> opgehaald.]]></string>
